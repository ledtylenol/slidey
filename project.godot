; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/is_live_update_enabled=false
General/banks_path="res://banks/Desktop"

[application]

config/name="slidey"
run/main_scene="uid://bfuiasbvgxahh"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=260
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bc32txhfxbjsj"
general/default_playback_type.web=0
general/3d_panning_strength=1.0

[autoload]

Shaker="*uid://1n0u463g865i"
Console="*uid://ouiu5xh1cs8n"
Classes="*uid://dcon8dsfmp8ai"
FmodManager="*uid://cds10pm7hwn3p"
GlobalBanks="*uid://bjgc3x1cnijkl"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/aspect="ignore"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/blender_godot_pipeline/plugin.cfg", "res://addons/console/plugin.cfg", "res://addons/fmod/plugin.cfg", "res://addons/func_godot/plugin.cfg", "res://addons/health_hitbox_hurtbox/plugin.cfg", "res://addons/raytraced_audio/plugin.cfg", "res://addons/richtext2/plugin.cfg", "res://addons/shaker/plugin.cfg")

[filesystem]

import/blender/enabled=false

