script = ExtResource("1_fj8hy")
shader_code = "	vec2 fuv = (vec2(uv) + 0.5f) / vec2(size);
	vec3 normal = get_view_normal(fuv);
	float d = texture(depth, uv_norm).r;
	vec2 suv =normalize(slide_uv(fuv, normal, d)) * 0.01;
	if (d == 0.0) return;
	float linear_depth = -length(get_cam_pos(fuv, d));
	float n = texture(noise, uv_norm + suv * 10.0 ).r * 20.0;
	float t = smoothstep(linear_depth - n , linear_depth - n + params.step_offset, -params.thres);
	t = step(bayer8(uv) + 0.01, t);
	if (t == 0.0) return;
	color.rgb = vec3(0.0);"
thres = 47.235
